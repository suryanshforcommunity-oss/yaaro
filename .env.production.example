# ==============================================================================
# YAARO PRODUCTION ENVIRONMENT CONFIGURATION
# Copy to .env.production (or set in Vercel / Cloud Dashboard)
# ==============================================================================

# NEXT.JS DEPLOYMENT URL
NEXT_PUBLIC_SITE_URL=https://yaaro.live

# SUPABASE PRODUCTION CREDENTIALS
# Obtain from Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-production-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# PAYMENT PROVIDER CONFIGURATION (Razorpay India)
# Set when moving from simulated mode to live gateway
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# TRUST & SAFETY MODERATION
ADMIN_SECRET_PASSPHRASE=your-strong-admin-passphrase-here
